{
  // Deploy from the repository root with: npx wrangler deploy
  // Wrangler builds ./Dockerfile for linux/amd64 and runs it as a Container.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hkia-mcp",
  "main": "cloudflare/src/index.js",
  "compatibility_date": "2026-11-22",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "HkiaContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HKIA_CONTAINER",
        "class_name": "HkiaContainer"
      }
    ]
  },
  "exports": {
    "HkiaContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
